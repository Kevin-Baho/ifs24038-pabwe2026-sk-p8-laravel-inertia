# Multi-stage build untuk BlogVerse Pro (FrankenPHP)
FROM dunglas/frankenphp:1-php8.4

# Set working directory
WORKDIR /app

# 1. SALIN SELURUH PROYEK TERLEBIH DAHULU (Agar file artisan dan composer ada di /app)
COPY . /app

# 2. Install system dependencies & PHP extensions yang dibutuhkan
RUN install-php-extensions \
    pdo_mysql \
    pdo_pgsql \
    pgsql \
    gd \
    zip \
    intl \
    opcache \
    bcmath

# 3. Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 4. Jalankan composer install (sekarang file artisan sudah ada, jadi package:discover tidak akan error)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# 5. Install Node.js untuk build frontend assets
RUN apt-get update && apt-get install -y nodejs npm
RUN npm install
RUN npm run build

# 6. Optimasi Laravel untuk Production
RUN php artisan view:cache
RUN php artisan event:cache

# 7. Set permission untuk storage dan bootstrap cache
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache
RUN chmod -R 775 /app/storage /app/bootstrap/cache

# FrankenPHP environment variables
ENV SERVER_NAME=":80"
ENV FRANKENPHP_CONFIG="worker ./public/index.php"

EXPOSE 80

# Jalankan FrankenPHP
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]