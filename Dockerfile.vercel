# ==============================================================================
# Stage 1: Build Frontend Assets (Vite, React 18, Tailwind CSS)
# ==============================================================================
FROM node:22-alpine AS frontend
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==============================================================================
# Stage 2: Install Composer Dependencies (No Dev, Optimized)
# ==============================================================================
FROM composer:2 AS vendor
WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --optimize-autoloader \
    --ignore-platform-reqs

# ==============================================================================
# Stage 3: Runtime using FrankenPHP (PHP 8.4 + Caddy)
# ==============================================================================
FROM dunglas/frankenphp:1-php8.4-bookworm AS runtime

# Copy PHP production ini
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Configure memory limit & execution limits for PHP runtime
RUN echo "memory_limit=256M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "upload_max_filesize=10M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "post_max_size=12M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "max_execution_time=60" >> "$PHP_INI_DIR/conf.d/custom.ini"

# Install required PHP extensions
# (pdo_mysql, gd, zip, intl, opcache, bcmath; mbstring and xml are built into FrankenPHP)
RUN install-php-extensions pdo_mysql gd zip intl opcache bcmath

WORKDIR /app

# Copy application files
COPY . /app
COPY --from=vendor /app/vendor /app/vendor
COPY --from=frontend /app/public/build /app/public/build

# Copy Caddyfile configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Ensure write permissions for writable directories (storage, bootstrap/cache)
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache && \
    chown -R www-data:www-data storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache

# Build-time caching: HANYA cache yang statis dan TIDAK bergantung pada runtime env.
# JANGAN jalankan config:cache dan JANGAN migrate saat build!
RUN php artisan view:cache || true && \
    php artisan event:cache || true

ENV PORT=80
EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
