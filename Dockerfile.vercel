# ==============================================================================
# Dockerfile.vercel — BlogVerse Pro (FrankenPHP, non-worker mode)
# ==============================================================================
# FrankenPHP mode: CGI klasik per-request (BUKAN worker mode)
# Worker mode membutuhkan frankenphp_handle_request() di PHP script,
# yang tidak dimiliki public/index.php Laravel standar.
# ==============================================================================

FROM dunglas/frankenphp:1-php8.4-bookworm

# Set working directory
WORKDIR /app

# Install PHP extensions yang dibutuhkan
RUN install-php-extensions \
    pdo_mysql \
    gd \
    zip \
    intl \
    opcache \
    bcmath

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Install Node.js (LTS) & ca-certificates untuk SSL TLS verification
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Salin seluruh proyek
COPY . /app

# Install Composer dependencies (production, optimized)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-progress

# Install npm dependencies dan build frontend assets
RUN npm ci && npm run build

# Build-time cache: HANYA view & event (TIDAK config:cache, TIDAK migrate)
RUN php artisan view:cache || true
RUN php artisan event:cache || true

# Set permission untuk storage dan bootstrap cache
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache \
    && chmod -R 775 /app/storage /app/bootstrap/cache

# Salin Caddyfile kita (menimpa default FrankenPHP)
COPY Caddyfile /etc/caddy/Caddyfile

# PENTING: JANGAN set FRANKENPHP_CONFIG="worker ..."
# ENV itu yang mengaktifkan worker mode dan menyebabkan error:
# "worker public/index.php has not reached frankenphp_handle_request()"
ENV PORT=80
ENV APP_ENV=production

EXPOSE 80

# Jalankan FrankenPHP dengan Caddyfile kita (CGI mode, bukan worker mode)
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
