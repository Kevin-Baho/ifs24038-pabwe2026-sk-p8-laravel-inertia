# Multi-stage build untuk BlogVerse Pro (FrankenPHP)
FROM dunglas/frankenphp:1-php8.4

# Install system dependencies & PHP extensions yang dibutuhkan
RUN install-php-extensions \
    pdo_mysql \
    pdo_pgsql \
    pgsql \
    gd \
    zip \
    intl \
    opcache \
    bcmath

# Set working directory
WORKDIR /app

# Copy composer files terlebih dahulu untuk caching layer
COPY composer.json composer.lock ./

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Install PHP dependencies tanpa dev dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Copy seluruh file proyek ke container
COPY . /app

# Install Node.js untuk build frontend assets
RUN apt-get update && apt-get install -y nodejs npm
RUN npm install
RUN npm run build

# Optimasi Laravel untuk Production (View & Event Cache)
RUN php artisan view:cache
RUN php artisan event:cache

# Set permission untuk storage dan bootstrap cache
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache
RUN chmod -R 775 /app/storage /app/bootstrap/cache

# FrankenPHP environment variables
ENV SERVER_NAME=":80"
ENV FRANKENPHP_CONFIG="worker ./public/index.php"

EXPOSE 80

# Jalankan FrankenPHP
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]