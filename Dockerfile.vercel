# ==============================================================================
# Stage 1: Build Frontend Assets (Vite, React 18, Tailwind CSS)
# ==============================================================================
FROM node:22-alpine AS frontend
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==============================================================================
# Stage 2: Install Composer Dependencies (No Dev, tanpa scripts)
# Skrip composer (package:discover) butuh file `artisan`, yang belum ada di
# stage ini, jadi dijalankan nanti di stage runtime.
# ==============================================================================
FROM composer:2 AS vendor
WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist \
    --ignore-platform-reqs

# ==============================================================================
# Stage 3: Runtime using FrankenPHP (PHP 8.4 + Caddy)
# ==============================================================================
FROM dunglas/frankenphp:1-php8.4-bookworm AS runtime

# PHP production ini + batas runtime
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    echo "memory_limit=256M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "upload_max_filesize=10M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "post_max_size=12M" >> "$PHP_INI_DIR/conf.d/custom.ini" && \
    echo "max_execution_time=60" >> "$PHP_INI_DIR/conf.d/custom.ini"

# Ekstensi PHP yang dibutuhkan
RUN install-php-extensions pdo_mysql gd zip intl opcache bcmath

# Composer dipakai untuk dump-autoload di bawah
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Source aplikasi + vendor + aset hasil build
COPY . /app
COPY --from=vendor /app/vendor /app/vendor
COPY --from=frontend /app/public/build /app/public/build

# Caddyfile
COPY Caddyfile /etc/caddy/Caddyfile

# Folder yang harus bisa ditulis
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache

# Autoload final + package discovery (sekarang `artisan` dan `vendor` sudah ada).
# JANGAN config:cache dan JANGAN migrate saat build.
RUN composer dump-autoload --no-dev --optimize --no-scripts && \
    php artisan package:discover --ansi && \
    (php artisan view:cache || true) && \
    (php artisan event:cache || true)

# Hak akses + izinkan FrankenPHP membuka port 80 sebagai user non-root
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache /config/caddy /data/caddy && \
    chmod -R 775 /app/storage /app/bootstrap/cache && \
    setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp

ENV PORT=80
EXPOSE 80

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]