APP_NAME="BlogVerse Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Untuk produksi Vercel: LOG_CHANNEL=stderr
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Set true di produksi agar tidak terjadi mixed-content pada asset
FORCE_HTTPS=false

# ==============================================================================
# Database Configuration (MySQL / MariaDB Online or Local)
# ==============================================================================
DB_CONNECTION=mysql
# Dukungan DB_URL langsung (misal dari TiDB Cloud / Railway):
# DB_URL=mysql://user:pass@host:4000/db?ssl-mode=REQUIRED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blogverse_pro
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi SSL CA MySQL/MariaDB (opsional jika penyedia butuh sertifikat khusus)
# Path sertifikat CA di container (mis. /etc/ssl/certs/ca-certificates.crt):
MYSQL_ATTR_SSL_CA=
# ATAU masukkan raw string PEM sertifikat langsung di environment variable Vercel:
MYSQL_ATTR_SSL_CA_CONTENT=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# ==============================================================================
# Stateless Session & Cache (Database-backed)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# Stateless: gunakan sync queue untuk Vercel Function
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ==============================================================================
# File Storage (Media Uploads: Cover & Avatar)
# ==============================================================================
# Di lokal: public. Di produksi Vercel: s3 atau r2
FILESYSTEM_DISK=public
MEDIA_DISK=public

# AWS S3 / Cloudflare R2 / S3-compatible Object Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_VISIBILITY=public

# Cloudflare R2 alias (opsional jika memilih prefix R2_*)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false
R2_VISIBILITY=public

# ==============================================================================
# Mailer
# ==============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# AI Post Generator (Groq / OpenAI API)
# ==============================================================================
OPENAI_ENDPOINT=https://api.groq.com/openai/v1
OPENAI_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
# Timeout request HTTP ke AI (dalam detik, default 50s agar aman di Vercel)
AI_TIMEOUT=50

# ==============================================================================
# Production Initial Admin Credentials (digunakan oleh AdminSeeder)
# ==============================================================================
ADMIN_NAME="Administrator"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@blogverse.pro"
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
